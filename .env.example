# SunShade Syndication Environment Variables (Local / Staging Template)
# Copy to .env (or apps/syndication-worker/.dev.vars for Wrangler) — NEVER commit real secrets.

# Supabase (local Docker default or staging instance)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=your-local-or-stag-service-role-key

# SunShade Links Shortener (use -stag subdomain for non-production)
LINKS_API_URL=https://links-stag.sunshade.icu
SUNSHADE_MASTER_API_KEY=your-sunshade-master-api-key

# Tracker Webhook Verification (X-SunShade-Signature-256)
TRACKER_WEBHOOK_SECRET=your-tracker-webhook-hmac-secret

# Hub Admin Gateway Healthcheck Token
INTERNAL_HEALTH_TOKEN=your-internal-health-token

# Build metadata injected at deploy time
BUILD_TIME=2026-11-12T00:00:00Z
